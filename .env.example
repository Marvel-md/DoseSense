# Where the synthetic cohort CSVs live
DOSESENSE_DATA=./data/synthetic

# Where model.pkl, metrics.json and the panel are written
DOSESENSE_ARTIFACTS=./artifacts

# Dashboard directory
DOSESENSE_FRONTEND=./frontend

# Clinician feedback store
DOSESENSE_DB=./artifacts/feedback.sqlite3

# Score only the first N patients at start-up. Scoring all 600 takes ~35s;
# 120 starts in ~9s and behaves identically. Leave unset or 0 for the full cohort.
# Evaluation always runs on the full cohort regardless of this setting.
DOSESENSE_PATIENT_LIMIT=0
